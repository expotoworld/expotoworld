# Local configuration file for Android build
# Copy this file to local.properties and fill in the values
# DO NOT commit local.properties to version control

sdk.dir=/path/to/your/Android/sdk
flutter.sdk=/path/to/your/flutter
flutter.buildMode=debug
flutter.versionName=1.0.0
flutter.versionCode=1

# Google Maps API Key
# Get your API key from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Make sure to restrict the key to your app's package name and SHA-1 fingerprint
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
