// iOS Secrets Configuration Template
// Copy this file to Secrets.xcconfig and fill in the values
// DO NOT commit Secrets.xcconfig to version control

// Google Maps API Key
// Get your API key from Google Cloud Console: https://console.cloud.google.com/apis/credentials
// Make sure to restrict the key to your app's bundle identifiers
Maps_API_KEY=your_google_maps_api_key_here
