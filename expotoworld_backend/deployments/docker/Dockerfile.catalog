# EXPO to WORLD - Catalog Service
# Multi-stage Docker build for production
#
# Build: docker build -t expotoworld-catalog-service -f deployments/docker/Dockerfile.catalog .
# Run: docker run -p 8080:8080 --env-file .env expotoworld-catalog-service

# ============================================
# Stage 1: Build
# ============================================
FROM golang:1.23-alpine AS builder

# Install required packages
RUN apk add --no-cache ca-certificates git tzdata

WORKDIR /app

# Copy go mod files first (for better layer caching)
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the service
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -trimpath \
    -o catalog-service ./services/catalog/cmd/server

# ============================================
# Stage 2: Runtime
# ============================================
FROM alpine:3.19

# Install ca-certificates for HTTPS and tzdata for timezones
RUN apk --no-cache add ca-certificates tzdata

# Create non-root user for security
RUN adduser -D -u 1001 appuser

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/catalog-service .

# Use non-root user
USER appuser

# Expose service port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/health || exit 1

# Run the service
CMD ["./catalog-service"]
