# EXPO to WORLD - Auth Service
# Multi-stage Docker build for production
#
# Build: docker build -t expotoworld-auth-service -f deployments/docker/Dockerfile.auth .
# Run: docker run -p 8081:8081 --env-file .env expotoworld-auth-service

# ============================================
# Stage 1: Build
# ============================================
FROM golang:1.23-alpine AS builder

# Install required packages
RUN apk add --no-cache ca-certificates git tzdata

WORKDIR /app

# Copy go mod files first (for better layer caching)
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the service
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -trimpath \
    -o auth-service ./services/auth/cmd/server

# ============================================
# Stage 2: Runtime
# ============================================
FROM alpine:3.19

# Install ca-certificates for HTTPS and tzdata for timezones
RUN apk --no-cache add ca-certificates tzdata

# Create non-root user for security
RUN adduser -D -u 1001 appuser

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/auth-service .

# Copy migrations if needed at runtime (optional)
# COPY --from=builder /app/migrations ./migrations

# Use non-root user
USER appuser

# Expose service port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8081/health || exit 1

# Run the service
CMD ["./auth-service"]
